{
  "name": "mobilemem-project-page",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "format": "prettier --write \"*.html\" assets/web/css assets/web/js scripts \"package*.json\" \"*.md\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"*.html\" assets/web/css assets/web/js scripts \"package*.json\" \"*.md\" \".github/**/*.yml\"",
    "images:build": "node scripts/build-image-manifest.mjs",
    "images:check": "node scripts/check-image-manifest.mjs",
    "references:check": "node scripts/check-static-references.mjs",
    "test:syntax": "node scripts/check-syntax.mjs",
    "test": "npm run format:check && npm run test:syntax && npm run images:check && npm run references:check"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
